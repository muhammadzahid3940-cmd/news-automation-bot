{
  "version": 2,
  "crons": [
    {
      "path": "/api/run",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/run.py": {
      "maxDuration": 300
    },
    "api/digest.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/digest",
      "destination": "/api/index"
    },
    {
      "source": "/api/live-cricket",
      "destination": "/api/live_cricket"
    }
  ]
}
