# ---------------------------------------------------------------------------
# News Automation Bot (CrewAI edition) - configuration
# ---------------------------------------------------------------------------

# LLM provider for the summarizer + crew agents.
# Priority: OpenAI -> Gemini (fallback).
# Tool 2: Intelligent Summarizer (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional fallback LLM (used only when the OpenAI key is absent)
GOOGLE_API_KEY=
GEMINI_API_KEY=
MODEL_NAME=gemini/gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest

# Tool 1: NewsFetcherTool - web search (Google News via Serper.dev) - required
SERPER_API_KEY=

# Tool 3: SlackBotTool - Slack distribution (optional - set to enable)
SLACK_WEBHOOK_URL=
# Live per-story Slack posts while summarizing (1 = on, 0 = off)
SLACK_LIVE=1
# Max number of per-story live posts per run (keeps the channel from flooding)
SLACK_LIVE_MAX=15

# Live cricket match details - real-time scores in Slack + web UI.
# Free key at https://www.cricapi.com (recommended). Without it, the bot falls
# back to live web-search snippets (needs SERPER_API_KEY).
CRICAPI_KEY=

# Auto-refresh: re-run the pipeline every N minutes (0 = off). Keeps the Slack
# feed and live cricket card current.
RUN_INTERVAL_MINUTES=0

# Tool 4: SheetsLoggerTool - Google Sheets logger (optional - set both to enable)
# Service account JSON - either paste the whole JSON inline...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or point to a local .json file
GOOGLE_SERVICE_ACCOUNT_FILE=
# ID of the Google Sheet to log into (from the sheet URL)
GOOGLE_SHEET_ID=

# The pipeline always fetches cricket news
SCHEDULE_TOPIC=cricket

# Web UI port (local)
WEB_PORT=8000
RUN_INTERVAL_MINUTES=15
